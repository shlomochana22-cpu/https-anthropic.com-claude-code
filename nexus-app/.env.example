# Supabase — copy to .env.local and fill in from your project's API settings.
# Without these, the app falls back to mock data in lib/events.ts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anthropic (Claude) — powers the "כתוב עם AI" event-description writer.
# Server-side only (never exposed to the browser). Without it, the AI button
# falls back to a local template draft. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY
